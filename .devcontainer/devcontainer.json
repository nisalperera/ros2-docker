{
  "name": "ROS 2 desktop-full",
  "dockerFile": "${localWorkspaceFolder}/.devcontainer/Dockerfile",
  "runArgs": [
    "--network=host",
    "--ipc=host",
    "--gpus=all",
    "-e", "QT_X11_NO_MITSHM=1",
    "-e", "NVIDIA_VISIBLE_DEVICES=all",
    "-e", "NVIDIA_DRIVER_CAPABILITIES=graphics,compute,utility,display",
    "--device-cgroup-rule=c 13:* rmw",
    "--name=ROS2-humble"
  ],
  "workspaceFolder": "/root/projects",
  "workspaceMount": "source=${localWorkspaceFolder}/projects,target=/root/projects,type=bind",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.bash_history,target=/root/.bash_history,type=bind",
    "source=${localWorkspaceFolder}/gazebo_models_worlds_collection/models,target=/root/gazebo/models,type=bind",
    "source=${localWorkspaceFolder}/gazebo_models_worlds_collection/worlds,target=/root/gazebo/worlds,type=bind",
    "source=${localWorkspaceFolder}/.ros,target=/root/.ros,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind",
    "source=/dev/dri,target=/dev/dri,type=bind",
    "source=/dev/input,target=/dev/input,type=bind",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached"
    // "source=${localEnv:XAUTHORITY},target=/root/.Xauthority,type=bind,ro"
  ],
  "build": {
    "context": "${localWorkspaceFolder}",
    "dockerfile": "${localWorkspaceFolder}/.devcontainer/Dockerfile",
    "args": {
      "ROS_DISTRO": "humble"
    },
    "tag": "ros2-humble"
  },
  "postStartCommand": "source /opt/ros/humble/setup.bash && cd /root/projects && colcon build --symlink-install",
  "initializeCommand": "xhost +local:docker",
  "postStopCommand": "xhost -local:docker && rm -rf projects/log projects/build projects/install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.makefile-tools",
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-python.debugpy",
        "ranch-hand-robotics.rde-pack",
        "ms-vscode.cpptools-extension-pack"
      ]
    }
  },
  "containerEnv": {
    "DISPLAY": ":0",
    "XAUTHORITY": "/root/.Xauthority"
  },
  "remoteEnv": {
    "DOCKER_BUILDKIT": "1"
  }
}